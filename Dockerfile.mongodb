FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements_mongodb.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements_mongodb.txt

# Copy application files
COPY am_data_pipeline_mongodb.py .
COPY am_dashboard.html .

# Create data storage directory
RUN mkdir -p am_data_storage

# Expose port
EXPOSE 8000

# Start server
CMD python am_data_pipeline_mongodb.py
